generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Peminjaman {
  id             String   @id @default(cuid())
  alat           String
  jumlah         Int
  tanggalKembali String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("peminjaman")
}