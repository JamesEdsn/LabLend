generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  STUDENT
  ASLAB
}

model User {
  id           String   @id @default(cuid())
  nama         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  peminjaman Peminjaman[]

  @@map("users")
}

model Alat {
  id           String   @id @default(cuid())
  nama         String   @unique
  kategori     String
  deskripsi    String?  @db.Text
  stokTotal    Int      @default(0)
  stokTersedia Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  peminjaman Peminjaman[]

  @@map("alat")
}

model Peminjaman {
  id             String @id @default(cuid())
  alat           String
  jumlah         Int
  tanggalKembali String

  alatId     String?
  inventaris Alat?   @relation(fields: [alatId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([alatId])
  @@map("peminjaman")
}
